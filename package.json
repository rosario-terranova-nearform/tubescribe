{
  "name": "tubescribe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local YouTube transcript corpus + grounded LLM bots (OpenRouter). pnpm monorepo.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @tubescribe/server dev\" \"pnpm --filter @tubescribe/web dev\"",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "start": "pnpm --filter @tubescribe/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
