# OpenRouter API key (required for chat + embeddings). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Server
PORT=3001
# Data directory: SQLite DB + transcript files live here (gitignored)
DATA_DIR=./data

# Default models (OpenRouter model ids, e.g. provider/model)
DEFAULT_CHAT_MODEL=openai/gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Extraction knobs (YouTube bot-detection defense, see docs/DESIGN.md)
TRANSCRIPT_CONCURRENCY=1
TRANSCRIPT_DELAY_MIN_MS=1000
TRANSCRIPT_DELAY_MAX_MS=3000
TRANSCRIPT_MAX_RETRIES=3
