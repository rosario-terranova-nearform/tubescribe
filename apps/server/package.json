{
  "name": "@tubescribe/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tubescribe Express API server",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tubescribe/shared": "workspace:*",
    "ai": "^7.0.137",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "gpt-tokenizer": "^4.0.0",
    "pino": "^9.6.0",
    "sqlite-vec": "^0.1.9",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
